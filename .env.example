# Disponibilizadas somente no ambiente Production da Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
CRON_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_SECRET=replace-with-at-least-40-random-characters-and-rotate-after-use

# Scanner compatível: POST binário; responde {"clean":true,"engine":"..."}.
ANTIMALWARE_API_URL=https://scanner.example.org/scan
ANTIMALWARE_API_TOKEN=replace-with-a-private-token

# Domínio canônico. Requisições HTML fora dele são redirecionadas em produção.
APP_URL=https://sistema.lardabencao.org

# Link de compartilhamento ("qualquer pessoa com o link") da pasta ESE no OneDrive.
# Opcional: sem ele, a Biblioteca de Estudos não mostra os links Roteiro / Perguntas / Texto.
ONEDRIVE_ESE_SHARE=
